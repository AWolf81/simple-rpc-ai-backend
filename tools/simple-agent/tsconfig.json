{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "baseUrl": "../../",
    "paths": {
      "@/*": ["src/*"],
      "@services/*": ["src/services/*"],
      "@services/ai": ["src/services/ai"],
      "@services/ai/*": ["src/services/ai/*"],
      "@services/resources": ["src/services/resources"],
      "@services/resources/*": ["src/services/resources/*"],
      "@services/mcp": ["src/services/mcp"],
      "@services/mcp/*": ["src/services/mcp/*"],
      "@services/billing": ["src/services/billing"],
      "@services/billing/*": ["src/services/billing/*"],
      "@services/security": ["src/services/security"],
      "@services/security/*": ["src/services/security/*"],
      "@auth/*": ["src/auth/*"],
      "@src-trpc/*": ["src/trpc/*"],
      "@database/*": ["src/database/*"],
      "@billing/*": ["src/billing/*"],
      "@security/*": ["src/security/*"],
      "@storage/*": ["src/storage/*"],
      "@schemas/*": ["src/schemas/*"],
      "@mcp/*": ["src/mcp/*"],
      "@monetization/*": ["src/monetization/*"],
      "@middleware/*": ["src/middleware/*"]
    },
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
