{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* === Core Setup === */
    "target": "ES2022",                    // modern Node syntax
    "module": "ESNext",                    // use ES modules (import/export)
    "moduleResolution": "bundler",         // best for tsx / ESM
    "jsx": "react-jsx",                    // for JSX/TSX with React 17+
    "allowJs": true,                       // if you mix JS/TS
    "esModuleInterop": true,               // makes 'import x from y' work properly
    "skipLibCheck": true,                  // faster builds
    "forceConsistentCasingInFileNames": true,

    /* === Type Safety === */
    "strict": true,                        // recommended strictness
    "resolveJsonModule": true,             // allow importing .json files

    /* === Node + CLI Environment === */
    "types": ["node"],                     // add Node typings
    //"noEmit": true,                        // if using `tsx` (no build output)
    
    /* === Output (only if building) === */
    "outDir": "dist",                   // uncomment if using `tsc` to build
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
